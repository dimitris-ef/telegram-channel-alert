# Copy this file to config.env and fill it in. Never upload config.env anywhere.

# ---- Telegram ----
# From https://my.telegram.org -> "API development tools"
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# Channels to watch, comma separated: @usernames, t.me links, or numeric ids (private channels).
# You must have joined them with your Telegram account.
CHANNELS=@first_channel,@second_channel

# ---- Pushover ----
# Your User Key: shown on https://pushover.net after you log in
PUSHOVER_USER=your_user_key_here
# Your app's API Token: create one at https://pushover.net/apps/build
PUSHOVER_TOKEN=your_app_token_here

# 2 = emergency: bypasses silent mode and repeats until you tap Acknowledge (recommended)
# 1 = high: bypasses silent mode, alerts once
# 0 = normal notification
PUSHOVER_PRIORITY=2
# Emergency only: repeat every N seconds (min 30), give up after N seconds (max 10800 = 3 h)
PUSHOVER_RETRY=30
PUSHOVER_EXPIRE=1800
# Optional sound name, e.g. siren, persistent, alien, echo. Empty = your app default.
PUSHOVER_SOUND=

# ---- Filters ----
# Which posts alert you: "all", or a comma list of:
#   text, photo, video, gif, file, audio, voice, poll
# Example: only photos and videos ->  TRIGGER_ON=photo,video
TRIGGER_ON=all

# Optional: only alert if the post text/caption contains one of these words
# (comma separated, not case-sensitive). Leave empty to ignore.
# Example: KEYWORDS=urgent,live,giveaway
KEYWORDS=

# Minimum seconds between two alerts from the same channel (a burst of posts alerts once)
COOLDOWN_SECONDS=120
