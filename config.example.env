# Copy this file to config.env and fill it in.

# From https://my.telegram.org -> "API development tools"
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# The channel to watch: its @username, a t.me link, or a numeric id (private channels)
CHANNEL=@channel_username

# YOUR Telegram @username - the account CallMeBot will call
CALL_USER=@your_username

# Which posts ring you: "all", or a comma list of:
#   text, photo, video, gif, file, audio, voice, poll
# Example: only photos and videos ->  TRIGGER_ON=photo,video
TRIGGER_ON=all

# Optional: only ring if the post text/caption contains one of these words
# (comma separated, not case-sensitive). Leave empty to ignore.
# Example: KEYWORDS=urgent,live,giveaway
KEYWORDS=

# Optional settings
CALL_LANG=en-GB-Standard-B
CALL_PREFIX=New post in the channel.
# Minimum seconds between two calls (so a burst of posts rings only once)
COOLDOWN_SECONDS=120
